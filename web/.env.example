# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX).
# Required to earn from the New Duel interstitial, the match-end interstitial,
# and the take-back rewarded ads. Without it the game uses Google test ads,
# then a house missive, so the flow still works on localhost.
#
# 1. Apply at https://www.google.com/adsense/ and add this site once it is live.
# 2. In AdSense, enable the Ad Placement API (H5 Games Ads).
# 3. Paste the publisher ID below (starts with ca-pub-).
# 4. Host ads.txt at the site root, using the pub- ID without the "ca-" prefix:
#      google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0
VITE_ADSENSE_CLIENT=ca-pub-3845995896948168

# Google AdMob units — required to earn from the Android app (Play / sideload).
# The website keeps using AdSense. The app WebView must send AdMob slots or
# Google will not fill breaks inside a mobile app.
#
# 1. Open https://apps.admob.com/ (same Google account as AdSense is fine).
# 2. Apps → Add app → Android. Package name: com.chessofwarlords.app
#    Copy the App ID (ca-app-pub-XXXX~YYYY) into
#    android/app/src/main/res/values/strings.xml as admob_app_id.
# 3. Create two ad units:
#      Interstitial  — used for New Duel and match-end.
#      Rewarded      — used for take-backs and hall banners.
# 4. Paste the unit IDs below (ca-app-pub-XXXX/YYYY). They are not the same
#    as the AdSense ca-pub- id.
# 5. Host app-ads.txt on your site (same place as ads.txt):
#      google.com, pub-YOUR_ADMOB_PUBLISHER_ID, DIRECT, f08c47fec0942fa0
#    Use the AdMob publisher id from AdMob → Settings → Account information
#    (pub-…, no ca-app- prefix). Set that site as the developer website in
#    Play Console when you publish.
# 6. Rebuild the web bundle and the Android APK after changing these values.
VITE_ADMOB_INTERSTITIAL=ca-app-pub-3845995896948168/4278370904
VITE_ADMOB_REWARDED=ca-app-pub-3845995896948168/1923670304

# Force AdSense test creatives even with a real publisher ID.
# VITE_ADS_TEST=1

# Play the house missive when Google has no fill. Default: on in development
# and whenever VITE_ADSENSE_CLIENT is empty; off in a paid production build.
# VITE_ADS_HOUSE=1

# Stripe Payment Link for the Merlin Pass (no ads), priced at USD 5.
# Create a one-time product in Stripe, turn on Adaptive Pricing so checkout
# shows the buyer's currency, and set the success URL to:
#   https://YOUR_DOMAIN/?merlin=success&session_id={CHECKOUT_SESSION_ID}
# VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxxxxxxx
